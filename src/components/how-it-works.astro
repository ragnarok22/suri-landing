---
import Foliage from '@/components/foliage.astro'

import { Download } from 'lucide-react'

const steps = [
  {
    n: '01',
    title: 'Download Suri',
    body: 'Grab the app from the App Store or download the APK directly — no sign-up required.',
  },
  {
    n: '02',
    title: 'Open & connect',
    body: 'Suri instantly recognizes your Telesur line and pulls in your balance and plans.',
  },
  {
    n: '03',
    title: 'Take control',
    body: 'Top up, buy data, transfer credit, and track usage — all from one clean home screen.',
  },
]
---

<section
  id="how-it-works"
  class="py-24 bg-teal text-cream overflow-hidden relative"
>
  <div
    aria-hidden="true"
    class="absolute inset-0 text-lime/10 bg-dot-grid pointer-events-none"
  >
  </div>
  <Foliage
    variant="lime"
    class="pointer-events-none absolute -top-16 -right-20 w-96 opacity-15 rotate-12"
  />

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <span
          class="inline-block font-display font-bold text-sm uppercase tracking-widest text-lime mb-4"
        >
          Up and running in minutes
        </span>
        <h2
          class="font-display text-4xl md:text-5xl font-extrabold mb-12 text-balance leading-[1.05]"
        >
          Simple. Fast. Connected.
        </h2>

        <ol class="space-y-8">
          {
            steps.map((step) => (
              <li class="flex gap-6 group">
                <div class="font-display text-4xl font-extrabold text-lime/40 group-hover:text-lime transition-colors tabular-nums shrink-0 w-16">
                  {step.n}
                </div>
                <div class="border-l border-cream/15 pl-6 pb-2">
                  <h3 class="font-display text-xl font-extrabold mb-2">
                    {step.title}
                  </h3>
                  <p class="text-cream/70 leading-relaxed max-w-md">
                    {step.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <a
          id="how-it-works-download"
          href="#download"
          class="mt-12 inline-flex items-center gap-2.5 px-7 py-4 bg-lime text-teal-deep rounded-2xl font-bold hover:bg-lime-deep transition-[background-color,transform] hover:-translate-y-1 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2 focus-visible:ring-offset-teal"
        >
          <Download
            className="w-5 h-5 group-hover:animate-bounce"
            aria-hidden="true"
          />
          <span>Get Suri now</span>
        </a>
      </div>

      <!-- Product screenshot -->
      <div class="flex justify-center">
        <div
          class="relative rounded-[2.5rem] bg-sky/10 backdrop-blur-sm p-4 ring-1 ring-cream/10"
        >
          <picture>
            <source
              srcset="/screenshot3-dark.webp"
              media="(prefers-color-scheme: dark)"
              width="280"
              height="606"
            />
            <img
              src="/screenshot3.webp"
              alt="Suri app confirming a quick mobile credit activation"
              width="280"
              height="606"
              loading="lazy"
              class="rounded-[2rem] shadow-2xl w-[240px] sm:w-[280px]"
            />
          </picture>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackEvent, trackSectionVisibility } from '@/lib/analytics'

  trackSectionVisibility('#how-it-works', 'how_it_works')

  document
    .querySelector('#how-it-works-download')
    ?.addEventListener('click', () => {
      trackEvent('download_start', {
        platform: 'android',
        location: 'how_it_works',
      })
    })
</script>
