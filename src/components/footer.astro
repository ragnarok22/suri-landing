---
import Foliage from '@/components/foliage.astro'

const currentYear = new Date().getFullYear()
---

<footer id="footer" class="bg-teal text-cream py-14 relative overflow-hidden">
  <Foliage
    variant="lime"
    class="pointer-events-none absolute -bottom-16 -right-12 w-72 opacity-10 rotate-6"
  />
  <div class="container mx-auto px-6 relative z-10">
    <div class="flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex items-center gap-2.5">
        <img
          src="/suri-logo.jpg"
          alt="Suri logo"
          width={36}
          height={36}
          class="w-9 h-9 rounded-xl"
        />
        <span class="font-display text-2xl font-extrabold">Suri</span>
      </div>

      <div
        class="flex flex-col sm:flex-row gap-4 sm:gap-8 text-sm text-cream/70 font-semibold text-center sm:text-left"
      >
        <a
          href="/privacy"
          class="hover:text-lime transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime rounded"
          >Privacy Policy</a
        >
        <a
          href="/terms"
          class="hover:text-lime transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime rounded"
          >Terms of Service</a
        >
      </div>

      <div class="text-sm text-cream/50">
        © {currentYear} Suri App. Made in Suriname.
      </div>
    </div>
  </div>
</footer>

<script>
  import { trackEvent, trackSectionVisibility } from '@/lib/analytics'

  trackSectionVisibility('#footer', 'footer')

  document.querySelectorAll('#footer a[href]').forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href') ?? ''
      trackEvent('cta_click', { type: 'footer_link', location: 'footer', href })
    })
  })
</script>
