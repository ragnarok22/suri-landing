---
import Foliage from '@/components/foliage.astro'

import { Smartphone } from 'lucide-react'

const screenshots = [
  {
    src: '/screenshot1.webp',
    darkSrc: '/screenshot1-dark.webp',
    alt: 'Suri app home screen showing balance check and mobile credit top-up options for Telesur',
    label: 'Home Dashboard',
  },
  {
    src: '/screenshot2.webp',
    darkSrc: '/screenshot2-dark.webp',
    alt: 'Suri app data plans interface displaying available Telesur prepaid data packages',
    label: 'Recharge Balance',
  },
  {
    src: '/screenshot3.webp',
    darkSrc: '/screenshot3-dark.webp',
    alt: 'Suri app payment confirmation screen for mobile credit and data plan activation',
    label: 'Quick Activation',
  },
  {
    src: '/screenshot4.webp',
    darkSrc: '/screenshot4-dark.webp',
    alt: 'Suri app usage overview screen showing data consumption and credit history',
    label: 'Transfer Balance',
  },
]
---

<section
  id="screenshots"
  class="py-24 bg-sky-soft dark:bg-muted relative overflow-hidden"
>
  <Foliage
    variant="teal"
    class="pointer-events-none absolute -bottom-10 -left-16 w-72 opacity-10 dark:opacity-15 rotate-12"
  />

  <div class="container mx-auto px-6 relative z-10">
    <!-- Section header -->
    <div class="max-w-2xl mb-14">
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 bg-teal text-cream dark:bg-lime dark:text-teal-deep rounded-full text-sm font-bold mb-5"
      >
        <Smartphone className="w-4 h-4" aria-hidden="true" />
        <span>See it in action</span>
      </div>

      <h2
        class="font-display text-4xl md:text-5xl font-extrabold text-foreground mb-4 text-balance leading-[1.05]"
      >
        Clean, friendly, and made to feel effortless.
      </h2>
      <p class="text-lg text-muted-foreground">
        Every screen is designed so managing your mobile services takes seconds,
        not minutes.
      </p>
    </div>

    <!-- Screenshots carousel -->
    <div
      class="flex justify-start lg:justify-center gap-6 lg:gap-10 overflow-x-auto snap-x snap-mandatory scroll-smooth pt-4 pb-14 px-4 md:px-0 -mx-4 md:mx-0 scrollbar-hide"
    >
      {
        screenshots.map((s, i) => (
          <div
            class:list={[
              'shrink-0 snap-center group',
              i % 2 === 1 && 'lg:translate-y-6',
            ]}
          >
            <div class="screenshot-card relative rounded-[2rem] bg-card p-2 shadow-lg shadow-teal/10 dark:shadow-black/30 ring-1 ring-border">
              <div
                aria-hidden="true"
                class="absolute top-0 left-1/2 -translate-x-1/2 w-24 h-5 bg-card rounded-b-2xl z-10"
              />
              <picture>
                <source
                  srcset={s.darkSrc}
                  media="(prefers-color-scheme: dark)"
                  width="240"
                  height="520"
                />
                <img
                  src={s.src}
                  alt={s.alt}
                  width="240"
                  height="520"
                  loading="lazy"
                  class="screenshot-img rounded-[1.5rem] object-cover w-[220px] md:w-[240px]"
                />
              </picture>
            </div>
            <p class="text-center text-sm font-bold text-muted-foreground mt-4 transition-colors duration-300 group-hover:text-teal dark:group-hover:text-lime">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>

    <p
      class="text-center text-sm text-muted-foreground mt-4 md:hidden"
    >
      Swipe to see more
    </p>
  </div>
</section>

<script>
  import { trackSectionVisibility } from '@/lib/analytics'

  trackSectionVisibility('#screenshots', 'screenshots')
</script>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .screenshot-card {
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      ring-color 0.35s ease;
  }

  .group:hover .screenshot-card {
    transform: translateY(-8px) scale(1.03);
    box-shadow:
      0 20px 40px -12px rgb(16 185 129 / 0.15),
      0 8px 16px -8px rgb(0 0 0 / 0.1);
    ring-color: rgb(16 185 129 / 0.3);
  }

  :global(.dark) .group:hover .screenshot-card {
    box-shadow:
      0 20px 40px -12px rgb(16 185 129 / 0.1),
      0 8px 16px -8px rgb(0 0 0 / 0.3);
  }

  .screenshot-img {
    transition:
      filter 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .group:hover .screenshot-img {
    filter: brightness(1.04);
  }
</style>
