---
import {
  Wallet,
  Zap,
  Wifi,
  ArrowLeftRight,
  EyeOff,
  PhoneCall,
} from 'lucide-react'
---

<section id="features" class="py-24 bg-background relative">
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-3xl mb-14">
      <span
        class="inline-block font-display font-bold text-sm uppercase tracking-widest text-lime-deep dark:text-lime mb-4"
      >
        Everything in one app
      </span>
      <h2
        class="font-display text-4xl md:text-5xl font-extrabold tracking-tight text-balance leading-[1.05]"
      >
        The whole Telesur toolbox, in your pocket.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      <!-- Highlight card -->
      <article
        class="md:col-span-2 md:row-span-2 bg-teal text-cream rounded-3xl p-8 lg:p-10 relative overflow-hidden group"
      >
        <div
          aria-hidden="true"
          class="absolute inset-0 text-lime/15 bg-dot-grid"
        ></div>
        <img
          src="/images/foliage-lime.png"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -bottom-10 -right-10 w-64 opacity-25 rotate-12"
        />
        <div class="relative z-10 flex flex-col h-full">
          <div
            class="w-14 h-14 bg-lime text-teal-deep rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform"
          >
            <Wallet className="w-7 h-7" aria-hidden="true" />
          </div>
          <h3 class="font-display text-2xl lg:text-3xl font-extrabold mb-3">
            Check &amp; recharge your balance
          </h3>
          <p class="text-cream/75 leading-relaxed max-w-md">
            Your current balance is right on the home screen — no codes to
            memorize. Top up in seconds with vouchers or a quick recharge.
          </p>
          <div class="mt-auto pt-8 flex items-center gap-6">
            <div>
              <div class="font-display text-3xl font-extrabold tabular-nums">
                &lt;5s
              </div>
              <div class="text-xs text-cream/60 font-semibold uppercase tracking-wide">
                to top up
              </div>
            </div>
            <div class="w-px h-10 bg-cream/20"></div>
            <div>
              <div class="font-display text-3xl font-extrabold tabular-nums">
                0
              </div>
              <div class="text-xs text-cream/60 font-semibold uppercase tracking-wide">
                USSD codes
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Small cards -->
      <article
        class="bg-card text-card-foreground rounded-3xl p-7 border border-border hover:border-lime dark:hover:border-lime transition-colors group"
      >
        <div
          class="w-12 h-12 bg-sky-soft dark:bg-muted text-teal dark:text-lime rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
        >
          <Wifi className="w-6 h-6" aria-hidden="true" />
        </div>
        <h3 class="font-display text-xl font-extrabold mb-2">
          Best data bundles
        </h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Compare every Telesur data plan by price and duration, then activate
          in a tap.
        </p>
      </article>

      <article
        class="bg-card text-card-foreground rounded-3xl p-7 border border-border hover:border-lime dark:hover:border-lime transition-colors group"
      >
        <div
          class="w-12 h-12 bg-sky-soft dark:bg-muted text-teal dark:text-lime rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
        >
          <ArrowLeftRight className="w-6 h-6" aria-hidden="true" />
        </div>
        <h3 class="font-display text-xl font-extrabold mb-2">
          Transfer balance
        </h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Send credit to friends and family on another Telesur number
          instantly.
        </p>
      </article>

      <!-- Bottom row -->
      <article
        class="bg-card text-card-foreground rounded-3xl p-7 border border-border hover:border-lime dark:hover:border-lime transition-colors group"
      >
        <div
          class="w-12 h-12 bg-sky-soft dark:bg-muted text-teal dark:text-lime rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
        >
          <EyeOff className="w-6 h-6" aria-hidden="true" />
        </div>
        <h3 class="font-display text-xl font-extrabold mb-2">Private number</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Hide your caller ID when you need a little extra privacy.
        </p>
      </article>

      <article
        class="bg-card text-card-foreground rounded-3xl p-7 border border-border hover:border-lime dark:hover:border-lime transition-colors group"
      >
        <div
          class="w-12 h-12 bg-sky-soft dark:bg-muted text-teal dark:text-lime rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
        >
          <PhoneCall className="w-6 h-6" aria-hidden="true" />
        </div>
        <h3 class="font-display text-xl font-extrabold mb-2">Useful numbers</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Emergency and service numbers for Suriname, always a tap away.
        </p>
      </article>

      <article
        class="bg-lime text-teal-deep rounded-3xl p-7 flex flex-col justify-center group"
      >
        <div
          class="w-12 h-12 bg-teal-deep/10 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
        >
          <Zap className="w-6 h-6" aria-hidden="true" />
        </div>
        <h3 class="font-display text-xl font-extrabold mb-2">
          Fast &amp; secure
        </h3>
        <p class="text-teal-deep/70 text-sm leading-relaxed">
          Encrypted transactions processed straight through your carrier.
        </p>
      </article>
    </div>
  </div>
</section>

<script>
  import { trackSectionVisibility } from '@/lib/analytics'

  trackSectionVisibility('#features', 'features')
</script>
