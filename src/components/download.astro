---
import Foliage from '@/components/foliage.astro'

import { Image } from 'astro:assets'
import { Download as DownloadIcon, Clock } from 'lucide-react'
---

<section id="download" class="py-24 bg-background relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div
      class="max-w-5xl mx-auto text-center bg-lime text-teal-deep rounded-[2.5rem] px-6 py-16 md:px-16 md:py-20 relative overflow-hidden"
    >
      <div
        aria-hidden="true"
        class="absolute inset-0 text-teal-deep/10 bg-dot-grid pointer-events-none"
      >
      </div>
      <Foliage
        variant="teal"
        class="pointer-events-none absolute -bottom-12 -left-12 w-64 opacity-20 rotate-6"
      />
      <Foliage
        variant="teal"
        class="pointer-events-none absolute -top-12 -right-12 w-64 opacity-20 -rotate-12 scale-x-[-1]"
      />

      <div class="relative z-10">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 bg-teal-deep/10 text-teal-deep rounded-full text-sm font-bold mb-6"
      >
        <DownloadIcon className="w-4 h-4" aria-hidden="true" />
        <span>Ready to get started?</span>
      </div>

      <h2
        class="font-display text-4xl md:text-6xl font-extrabold mb-6 text-balance leading-[1]"
      >
        Download Suri today.
      </h2>
      <p
        class="text-lg text-teal-deep/75 mb-12 max-w-2xl mx-auto font-medium"
      >
        Join thousands of Surinamers managing their Telesur credit and data the
        easy way. Free, secure, and ready in minutes.
      </p>

      <div class="flex flex-col md:flex-row items-center justify-center gap-6">
        <a
          href="https://github.com/ragnarok22/suri-landing/releases/download/v0.3.2-1/v0.3.2.1.apk"
          id="download-apk"
          class="transition-transform hover:scale-105 hover:drop-shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2 focus-visible:ring-offset-lime rounded-lg"
        >
          <Image
            src="/apk-badge.svg"
            alt="Download Android APK"
            width={180}
            height={60}
          />
        </a>

        <div class="relative">
          <div class="relative block opacity-60 grayscale pointer-events-none">
            <Image
              src="/google-play-badge.png"
              alt="Google Play - Coming Soon"
              width={180}
              height={60}
            />
          </div>
          <div
            class="absolute -top-2 -right-2 flex items-center gap-1.5 bg-teal text-cream text-xs font-bold px-2.5 py-1 rounded-full shadow-lg"
          >
            <Clock className="w-3 h-3" aria-hidden="true" />
            <span>Soon</span>
          </div>
        </div>

        <a
          href="https://apps.apple.com/app/suri-app/id6736572891"
          id="download-apple"
          class="transition-transform hover:scale-105 hover:drop-shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2 focus-visible:ring-offset-lime rounded-lg"
        >
          <Image
            src="/app-store-badge.svg"
            alt="Download on App Store"
            width={180}
            height={60}
          />
        </a>
      </div>

      <div
        class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 text-sm text-teal-deep/80 font-semibold"
      >
        <span class="flex items-center gap-2">
          <div class="w-2 h-2 bg-teal-deep rounded-full"></div>
          No account required
        </span>
        <span class="flex items-center gap-2">
          <div class="w-2 h-2 bg-teal-deep rounded-full"></div>
          100% secure
        </span>
        <span class="flex items-center gap-2">
          <div class="w-2 h-2 bg-teal-deep rounded-full"></div>
          Always free
        </span>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { trackEvent, trackSectionVisibility } from '@/lib/analytics'

  document.querySelector('a#download-apk')?.addEventListener('click', () => {
    trackEvent('download_start', { platform: 'android', location: 'download' })
  })

  document.querySelector('a#download-apple')?.addEventListener('click', () => {
    trackEvent('download_start', { platform: 'ios', location: 'download' })
  })

  trackSectionVisibility('#download', 'download')
</script>
